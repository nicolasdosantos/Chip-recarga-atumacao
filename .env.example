# copie esse arquivo pra ".env" e ajuste o que precisar
# o .env de verdade NUNCA deve ir pro git (ja ta no .gitignore)
#
# como esta aqui (FONTE_DADOS=local), o projeto ja roda direto depois do
# "pip install -r requirements.txt", sem precisar configurar Google Cloud -
# ele le data/example_data.xlsx (dado ficticio) em vez da planilha real.

FONTE_DADOS=local

# só sao usados quando FONTE_DADOS=sheets (uso real, planilha da empresa)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
SPREADSHEET_ID=coloque_o_id_da_planilha_aqui
SPREADSHEET_TAB_NAME=Fly

# regra de negocio - depois de quantos dias sem recarga o chip entra na lista
RECARGA_INTERVALO_DIAS=30

# valor minimo de cada recarga, usado pra calcular o total
VALOR_MINIMO_RECARGA=20.00

# notificacao no discord (opcional) - manda um resumo pra DM de alguem via
# automacao de interface (abre o app Discord instalado localmente e usa o
# Ctrl+K pra achar a conversa). deixe DISCORD_ATIVADO=false se nao quiser
# usar isso (precisa do Discord desktop + wmctrl/xdotool instalados).
DISCORD_ATIVADO=false
DISCORD_CONTATO_NOME=nome_de_exibicao_no_discord
DISCORD_DELAY_DIGITACAO_MS=200
